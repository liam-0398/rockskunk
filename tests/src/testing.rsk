; rockskunk full feature integration test
; every working piece of the language, feeding into ONE final accumulator
; expected final value is spelled out at each tier - check it as you go

; --- helper: float chain, mirrors the original chainer stress test ---
F applyRate(amount: f, rate: f) {
    grown := amount * rate + 1.0f
    r := grown
}

; --- helper: int chain, exercises the integer path through the same evaluator ---
F scaleInt(base, factor) {
    total := base * factor + 3
    r := total
}

F main() {

    ; === tier 1: float function call, chained math inside it ===
    ; applyRate(10.0, 2.0) = 10*2+1 = 21.0
    principal := 10.0f
    rate := 2.0f
    floatResult := applyRate(principal: f, rate: f)
    printf(floatResult)

    ; === tier 2: int function call, chained math, constant folding path ===
    ; scaleInt(4, 5) = 4*5+3 = 23
    intResult := scaleInt(4, 5)
    printw(intResult)

    ; === tier 3: nested loops accumulating into one running total ===
    ; outer i: 1..3, inner j: 1..2 -> 3*2 = 6 increments total
    ; total starts at 0, +1 each innermost pass = 6
    total := 0
    i := 1
    LW (i <= 3) {
        j := 1
        LW (j <= 2) {
            total := total + 1
            j := j + 1
        }
        i := i + 1
    }
    printw(total)
    ; total is now 6

    ; === tier 4: when-conditional adjusts the running total ===
    ; total (6) <= 10, so this branch fires: total := total + 100
    W (total <= 10) {
        total := total + 100
    }
    printw(total)
    ; total is now 106

    ; === tier 5: a when that should NOT fire ===
    ; total (106) <= 10 is false, skipped entirely
    W (total <= 10) {
        total := total + 9999
    }
    printw(total)
    ; total is still 106 - if this prints 10105, the when-skip is broken

    ; === tier 6: fold everything into the single final value ===
    ; intResult (23) added into total (106) via the plain int chainer
    final := total + intResult
    printw(final)
    ; final = 106 + 23 = 129

    r := final
}

