; DD

|V buf[8192] |

P destroyDisk() {
    bytes := 1
    total := 0
    infile := argv(1)
    outfile := argv(2)
    fd := open(infile, 0, 0)
        ; raw linux syscall, no libc -1 isnt catchall for error
        W (fd < 0 ) { writeln('NO SOURCE') exit(1)}
    fd2 := open(outfile, 65, 420)
        W (fd2 < 0 ) { writeln('NO DESTINATION') exit(1)}

    LW (bytes > 0) {
        bytes := read(fd, buf, 8192)
        write(fd2, buf, bytes) 
        total := total + bytes}
    close(fd) close(fd2)
    total := total / 1024
    printw(total)
}

P main() { destroyDisk() exit(0)}