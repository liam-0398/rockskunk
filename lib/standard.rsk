; ROCKSKUNK
; STANDARD LIBRARY

; I/O ----------------------------------------------------------------

F read(fd, buf, count) { r := sys(0,fd ,buf ,count) }
F write(fd, buf, count) { r := sys(1,fd ,buf ,count) }
F open(path, flags, mode) { r := sys(2,path , flags, mode) }
F lseek(fd, offset, whence) { r := sys(8, fd, offset, whence) }
F unlink(path) { r := sys(87, path, 0, 0) }
F fstat(fd, statbuf) { r := sys(5, fd, statbuf, 0) }
F mkdir(path, mode) { r := sys(83, path, mode, 0) }

; STRINGS ----------------------------------------------------------------

P writeLn(s) {
	len := s^
	dataptr := s + 8
	r1 := sys(1, 1, dataptr, len)

	nl := '\n'
	nllen := nl^
	nldata := nl + 8
	r2 := sys(1, 1, nldata, nllen)
}

F ccmp(p, q) {
    ; walk both byte-by-byte until mismatch or double null
    ; needs the byte-deref primitive either way
}


; MATH ----------------------------------------------------------------

F intAbs(value) {
    r := value
   ; W (value < 0) { r := 0 - value }
}

F floatAbs(value: f) {
  ; W (value < 0) { r := 0 - value}
    r := value
}


; Utility --------------------------------------------------------------------

F getpid() { r := sys(39, 0, 0, 0) }
F brk(addr) { r := sys(12, addr, 0, 0) }
F exit(code) { r := sys(60, code, 0, 0) }

F argCount() {
    r := argc
}

F argPtr(i) {
    r := argv + (i * 8)     ; address of the argv[i] slot itself
}

F argRaw(i) {
    p := argPtr(i)
    r := p^                 ; the actual char* — a C string, null-terminated
}

; END
