; ADVANCED REVERB TESTING

; ============================================================
; schroeder comb + damping cascade + output smoother
; DC in 0.25, comb feedback 0.5  ->  1/(1-g) * 0.25 = 0.5
; every stage after it is unity-gain at DC, so it stays 0.5
; ============================================================

|V  dbuf{4096}
    st{4}
|

F onepole(sig: f, coef: f, state: f) {
    d := sig - state
    s := d * coef
    r := state + s
}

P main() {
    xin  := 0.25f   g    := 0.5f
    damp := 0.05f   smth := 0.02f
    zero := 0.0f

    y   := 0.0f     dly := 0.0f
    fb  := 0.0f     v   := 0.0f
    sig := 0.0f     sv  := 0.0f
    ds  := 0.0f     dm  := 0.0f

    wp  := 0        wpv := 0
    wpp := &wp      i   := 0
    n   := 0

    LF (i := 0 until 4096) {
        dbuf{i} := zero
    }

    LF (n := 0 until 200000000) {
        wpv := wpp^
        dly := dbuf{wpv}
        fb  := dly * g
        v   := xin + fb
        dbuf{wpv} := v

        wp := wp + 1
        W (wp = 4096) {
            wp := 0
        }

        sig := v

        DO (k := 0 until 4) {
            sv  := st{k}
            ds  := sig - sv
            dm  := ds * damp
            sv  := sv + dm
            st{k} := sv
            sig := sv
        }

        y := onepole(sig, smth, y)
    }

    printf(y)
    printc(10)
}
