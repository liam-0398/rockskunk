; COMPILER MIGRATION VALIDATION

F add(a, b) {
    r := a + b
}

F addf(a: f, b: f) {
    r := a + b
}

F main() {
    x := 5
    y := 10
    z := add(x, y)
    printw(z)

    fx := 2.5f
    fy := 1.5f
    fz := addf(fx, fy)
    printf(fz)

    i := 0
    LF (i := 0 until 5) {
        printw(i)
    }

    LW (i < 10) {
        i := i + 1
        printw(i)
    }

    W (x = 5) {
        printw(x)
    }

    r := 0
}