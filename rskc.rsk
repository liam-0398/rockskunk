; Input/Output ==========================================================

P openFiles() {
    path := '/NFS/Code/rockskunk/src/playground.rsk'
    dataptr := path + 8
    fd := open(dataptr, 0, 0)

    IF (fd < 0)  {
        r := 0 - 1
    } E {
        n := read(fd, buffer, 65536)
        close(fd)
        r := n
    }
}

P closeFiles() {}

