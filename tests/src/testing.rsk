

; rockskunk stress test
; escalating - stop at the first function whose asm looks wrong

; --- tier 1: two operands, the case that already worked ---

F t1_pair(a: f, b: f) {
    r := a + b
}

; --- tier 2: three+ operands, literal at the tail (the original bug) ---

F t2_tail(a: f, b: f) {
    total := a + b + 100.0f
    r := total
}

; --- tier 3: literal in the middle, and leading ---

F t3_mid(a: f, b: f) {
    total := a + 2.0f + b
    r := total
}

F t3_lead(a: f, b: f) {
    total := 10.0f + a + b
    r := total
}

; --- tier 4: four operands, mixed ops, repeated literal ---

F t4_chain(a: f, b: f) {
    total := a + b - 2.0f + 2.0f
    r := total
}

; --- tier 5: mul and div in a chain ---

F t5_muldiv(a: f, b: f) {
    total := a * b / 2.0f
    r := total
}

; --- tier 6: bare var, bare literal, no operator at all ---

F t6_bare(a: f) {
    copy := a
    lit := 7.5f
    total := copy + lit
    r := total
}

; --- tier 7: integer path, immediates and vars ---

F t7_int(n) {
    total := n + 1
    total := total + n
    r := total
}

; --- tier 8: integer constant fold, should collapse at compile time ---

F t8_fold() {
    folded := 5 + 5
    r := folded
}

; --- tier 9: call results feeding a chain ---

F t9_calls(a: f, b: f) {
    one := t1_pair(a: f, b: f)
    two := t2_tail(a: f, b: f)
    total := one + two + 1.0f
    r := total
}

F main() {
    x := 3.0f
    y := 4.0f
    n := 2

    r1 := t1_pair(x: f, y: f)
    printf(r1)

    r2 := t2_tail(x: f, y: f)
    printf(r2)

    r3 := t3_mid(x: f, y: f)
    printf(r3)

    r4 := t3_lead(x: f, y: f)
    printf(r4)

    r5 := t4_chain(x: f, y: f)
    printf(r5)

    r6 := t5_muldiv(x: f, y: f)
    printf(r6)

    r7 := t6_bare(x: f)
    printf(r7)

    r8 := t7_int(n)
    printw(r8)

    r9 := t8_fold()
    printw(r9)

    r10 := t9_calls(x: f, y: f)
    printf(r10)

    r := 0
}
