; ROCKSKUNK COMPILER
; 

|V  buffer![4096]
    tokenType[4096]
    tokenValue[4086]
    tokenCount := 0
    bytes := 0
|


; Utilities ============================================================


; NASM =================================================================


; Vectors ---------------------------------------------------------------


; Input/Output ==========================================================

P openFiles() {
    path := '/NFS/Code/rockskunk/src/playground.rsk'
    dataptr := path + 8
    fd := open(dataptr, 0, 0)

    IF (fd < 0)  {
        r := 0 - 1
    } E {
        bytes := read(fd, buffer, 65536)
        close(fd)
        r := bytes
    }
}

P closeFiles() {}

; Sub-Components ======================================================

; Optimization ---------------------------------------------------------

F foldCode() {}

; Intermediate =========================================================

F evaluateExpression() {}

P discriminateIdentifier() {}

; Parser ==============================================================

P parser() {}

; Lexer ===============================================================

P tokenize(char, ident) {
    tokenType[tokenCount] := ident
    tokenVal[tokenCount] := char
    tokenCount := tokenCount + 1
}

P lexer() {

    i := 0
    LW (i < bytes) {
        IF (buffer[i] = '=') {
            tmp := 'EQUAL'  
            tokenize(buffer[i], tmp)
        }






    }


















}

; INIT ================================================================

F main() {
    msg_init := 'RSKC - INIT'
    writeLn(msg_init)
    openFiles()
    lexer()
    parser()

}