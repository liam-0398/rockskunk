<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language SYSTEM "language.dtd">
<!--
  rockskunk syntax highlighting for Kate / KWrite / KDevelop
  (KSyntaxHighlighting framework)

  Color categories adapted to match Kate's stock Pascal preset (pulled
  directly from the real pascal.xml), not just "some default styles" -
  the two confirmed, load-bearing facts from that file that shaped this:
    - Pascal colors almost nothing: no operators, no punctuation, no
      function/variable names. Only keywords, types, numbers, strings,
      comments, and compiler directives get a color at all.
    - Pascal's word-based operators (and/or/xor/not/div/mod) are plain
      dsKeyword, same bucket as every other reserved word - there's no
      separate "operator" category for them, only symbol operators (+,
      :=, <, etc) go fully uncolored.
  Uses only semantic default styles (dsKeyword, dsDataType, dsString,
  etc) throughout - no hardcoded colors anywhere - so this still looks
  correct and consistent in both light and dark schemes automatically.

  Checked against the actual compiler source, not just the language
  README, so a few real behaviors are intentionally reflected here
  rather than smoothed over - see the comments near the relevant rules:
    - OR/AND only work uppercase; NOT only works lowercase; NOR/XOR work
      either way but not mixed case.
    - V/S/D/R are only keywords glued directly to a preceding "|" - a
      variable named v, R, etc. elsewhere is just a variable.
    - ' is always a string quote, never an optional statement terminator.
    - Records, vector ops, and a few helper functions are highlighted as
      spec-only since the compiler doesn't implement them yet.

  A few "name after keyword, possibly with whitespace in between" cases
  (F/P function names, |R record names, the f/s type tag) are handled
  with a context push rather than a lookbehind assertion containing \s*
  or \s+ - regex engines including the PCRE2 family Kate is built on
  require lookbehind to be fixed-width, so a variable-width lookbehind
  is a real portability risk rather than just a style choice.
-->
<language name="Rockskunk" version="2" kateversion="5.79" section="Sources"
           extensions="*.rsk" author="liam-0398" license="MIT" casesensitive="1">
  <highlighting>

    <list name="repeatKeyword">
      <item>LF</item>
      <item>LW</item>
      <item>DO</item>
      <item>LOCATE</item>
      <item>until</item>
    </list>
    <list name="conditionalKeyword">
      <item>W</item>
      <item>IF</item>
      <item>E</item>
    </list>
    <list name="statementKeyword">
      <item>BREAK</item>
    </list>
    <list name="reservedKeyword">
      <item>CALL</item>
    </list>
    <list name="includeKeyword">
      <item>ADD</item>
    </list>
    <!-- OR/AND: uppercase only, no lowercase lexer path exists for them,
         despite some README examples showing lowercase usage. -->
    <list name="logicalWord">
      <item>OR</item>
      <item>AND</item>
    </list>
    <!-- NOR/XOR: work uppercase (keyword table) or lowercase (a triple
         char lexer shortcut), but not mixed case. not: lowercase only,
         there is no uppercase NOT in the keyword table. -->
    <list name="bitwiseWord">
      <item>NOR</item>
      <item>nor</item>
      <item>XOR</item>
      <item>xor</item>
      <item>not</item>
    </list>

    <contexts>

      <!-- Normal MUST be listed first: Kate uses whichever <context> is
           first in the file as the starting context when it begins
           highlighting a document. It was previously listed after the
           helper contexts below, which meant every file actually
           started in the "Numbers" context instead - explaining why
           only numeric literals were highlighting and nothing else. -->

      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">

        <RegExpr String=";.*$" attribute="Comment" context="#stay"/>

        <!-- ' is always a string delimiter to the real lexer - never a
             statement terminator. lineEndContext="#pop" below on the
             String context means an unterminated string just stops at
             end of line instead of silently swallowing the rest of the
             file the way the real compiler currently does on the same
             mistake. -->
        <DetectChar char="'" attribute="String" context="String"/>

        <!-- |R recordName - not an implemented lexer token at all yet
             (records are spec-only), kept lenient rather than matched
             to a real rule. No trailing apostrophe expected - that
             character is always a string quote, never a terminator. -->
        <RegExpr String="\|R\b" attribute="Keyword" context="RecordDefName"/>

        <!-- |D is styled like Pascal's own {$...} compiler directives
             (dsOthers) - see Directive in itemDatas. |V |S are styled
             like Pascal's own var/const reserved words (dsKeyword),
             matching how Pascal treats its own declaration keywords.
             |V |S |D require zero whitespace between the pipe and the
             letter - matches the real lexer exactly: the double-char
             check tests the literally-adjacent next byte, so "| V"
             (with a space) genuinely tokenizes as bitwise-or then a
             plain identifier "V", not a block header. V/S/D are NOT
             real standalone keywords - only glued to a preceding "|" -
             a variable literally named v/V/s/S/d/D elsewhere (very
             plausible in DSP code: voltage, sample, delay) is just a
             variable. -->
        <RegExpr String="\|D\b" attribute="Directive" context="#stay"/>
        <RegExpr String="\|(?=[VS]\b)" attribute="Keyword" context="#stay"/>
        <RegExpr String="(?&lt;=\|)[VS]\b" attribute="Keyword" context="#stay"/>

        <!-- a bare | ending a line closes a V/S/D/R block; styled to
             match the open (Keyword), same as Pascal colors begin and
             end the same way. Elsewhere | is bitwise or (handled
             further down, styled Normal Text like every other
             operator symbol below - see the note near those rules). -->
        <RegExpr String="\|\s*(;.*)?$" attribute="Keyword" context="#stay"/>

        <!-- function definition name: F name( / P name( -->
        <RegExpr String="\b[FP]\b" attribute="Structural" context="FuncDefName"/>

        <!-- W IF E BREAK LOCATE CALL ADD DO LF LW are matched case
             sensitively, uppercase-exact, by the real lexer's keyword
             table - true standalone reserved words regardless of
             context (yes, a variable genuinely named e.g. "DO" would
             confuse the real compiler too; that's the language, not a
             highlighting quirk). 'until' is not actually checked by
             the parser - kept for readability/convention only. F/P are
             handled above (they push FuncDefName) rather than here.
             LF/LW/DO/LOCATE/until and W/IF/E get the Structural style
             (see itemDatas) - these are the tokens that mark out a
             program's actual shape (function bounds, loop bounds,
             branch bounds), worth a step of visual distinction from
             the rest of the reserved words. BREAK/CALL/ADD/OR/AND/
             NOR/XOR/not stay on plain Keyword, matching Pascal's own
             flat treatment - Pascal lumps begin, if, while, and, or,
             xor, div, mod etc into one undifferentiated "keywords"
             list with no further subdivision at all; this file goes
             one step further than stock Pascal only for the handful
             of tokens that actually delimit program structure. -->
        <keyword String="repeatKeyword" attribute="Structural" context="#stay"/>
        <keyword String="conditionalKeyword" attribute="Structural" context="#stay"/>
        <keyword String="statementKeyword" attribute="Keyword" context="#stay"/>
        <keyword String="reservedKeyword" attribute="Keyword" context="#stay"/>
        <keyword String="includeKeyword" attribute="Keyword" context="#stay"/>
        <keyword String="logicalWord" attribute="Keyword" context="#stay"/>
        <keyword String="bitwiseWord" attribute="Keyword" context="#stay"/>

        <!-- type annotation: (a, b: f) / (a: s) -->
        <RegExpr String=":(?=\s*[fs]\b)" attribute="Operator" context="TypeTag"/>

        <!-- implicit return variable r (r := ...) -->
        <RegExpr String="\br\b(?=\s*:)" attribute="BuiltIn" context="#stay"/>

        <!-- array{1} float element - only when { is glued to the identifier -->
        <RegExpr String="(?&lt;=\w)\{" attribute="IndexDelim" context="IndexFloat"/>
        <!-- array&lt;1&gt; string element - only when &lt; is glued to the
             identifier (spec-only, not implemented yet) -->
        <RegExpr String="(?&lt;=\w)&lt;" attribute="IndexDelim" context="IndexString"/>
        <!-- array![1] byte element -->
        <RegExpr String="(?&lt;=\w)!(?=\[)" attribute="Operator" context="#stay"/>

        <IncludeRules context="Numbers"/>
        <IncludeRules context="Builtins"/>

        <!-- generic function call, e.g. myFunc( - must stay after every
             more-specific rule above so those win first -->
        <RegExpr String="[A-Za-z_][A-Za-z0-9_]*(?=\s*\()" attribute="Function" context="#stay"/>

        <!-- member access: record.field (not yet implemented, spec-only) -->
        <RegExpr String="(?&lt;=\.)[A-Za-z_][A-Za-z0-9_]*" attribute="Variable" context="#stay"/>
        <DetectChar char="." attribute="Operator" context="#stay"/>

        <!-- assignment operators - plain := is the only form the
             compiler actually emits today; the rest are documented but
             not yet implemented. Longest/most-specific listed first. -->
        <RegExpr String=":\+\+=|:\*\*=|://=|:%%=" attribute="Operator" context="#stay"/>
        <RegExpr String=":\+=|:\*=|:-=|:/=|:%=" attribute="Operator" context="#stay"/>
        <StringDetect String="::=" attribute="Operator" context="#stay"/>
        <StringDetect String=":=" attribute="Operator" context="#stay"/>

        <!-- vector / increment operators (spec-only; VADD/VMUL tokens
             exist in the lexer but have no dispatch case yet) -->
        <RegExpr String="(?&lt;=[A-Za-z0-9_])\+\+(?=\s*(['});]|$))" attribute="Operator" context="#stay"/>
        <StringDetect String="*+" attribute="Operator" context="#stay"/>
        <RegExpr String="\+\+|--|\*\*|//|%%" attribute="Operator" context="#stay"/>

        <!-- address-of -->
        <RegExpr String="&amp;(?=[A-Za-z_])" attribute="Operator" context="#stay"/>

        <!-- real symbols per the lexer: $ is bitwise-and, | is bitwise
             or, &lt;&lt; &gt;&gt; are SHL/SHR. &amp; is address-of only,
             never bitwise. -->
        <RegExpr String="&lt;&lt;|&gt;&gt;|\$|\|" attribute="Operator" context="#stay"/>
        <RegExpr String="&lt;=|&gt;=|&lt;|&gt;|=" attribute="Operator" context="#stay"/>

        <IncludeRules context="ArithOp"/>

        <!-- punctuation -->
        <AnyChar String="{}" attribute="Normal Text" context="#stay"/>
        <AnyChar String="[]" attribute="Normal Text" context="#stay"/>
        <AnyChar String="()" attribute="Normal Text" context="#stay"/>
        <DetectChar char="," attribute="Normal Text" context="#stay"/>

        <IncludeRules context="GenericVariable"/>

      </context>

      <!-- ==== reusable rule groups, spliced in via IncludeRules ==== -->

      <context name="Numbers" attribute="Normal Text" lineEndContext="#stay">
        <RegExpr String="(?&lt;![A-Za-z0-9_.])\d+\.\d+f(?![A-Za-z0-9_])" attribute="Float" context="#stay"/>
        <RegExpr String="(?&lt;![A-Za-z0-9_.])\d+f(?![A-Za-z0-9_])" attribute="Float" context="#stay"/>
        <RegExpr String="(?&lt;![A-Za-z0-9_.])\d+\.\d+(?![A-Za-z0-9_f])" attribute="Error" context="#stay"/>
        <RegExpr String="(?&lt;![A-Za-z0-9_.])\d+(?![A-Za-z0-9_.])" attribute="DecVal" context="#stay"/>
      </context>

      <context name="Builtins" attribute="Normal Text" lineEndContext="#stay">
        <!-- real compiler intrinsics (special-cased codegen, not ordinary calls) -->
        <RegExpr String="\b(sys|printf|printw|intToFloat|floatToInt)\b(?=\s*\()" attribute="BuiltIn" context="#stay"/>
        <!-- vector ops - not yet implemented, spec-only -->
        <RegExpr String="\b(v|vabs|vsqrt|vsin|vcos|vmin|vmax|vfloor|vceil)\b(?=\s*\()" attribute="Extension" context="#stay"/>
        <!-- documented streamlining/memory helpers - not yet implemented, spec-only -->
        <RegExpr String="\b(lint|brot|cm|fm|align)\b(?=\s*\()" attribute="Extension" context="#stay"/>
      </context>

      <context name="ArithOp" attribute="Normal Text" lineEndContext="#stay">
        <RegExpr String="[+*/%-]" attribute="Operator" context="#stay"/>
      </context>

      <context name="GenericVariable" attribute="Normal Text" lineEndContext="#stay">
        <RegExpr String="[A-Za-z_][A-Za-z0-9_]*" attribute="Variable" context="#stay"/>
      </context>

      <!-- name-after-keyword helper contexts (see the note above on why
           these are context pushes rather than variable-width lookbehind) -->

      <context name="FuncDefName" attribute="Normal Text" lineEndContext="#pop">
        <RegExpr String="[A-Za-z_][A-Za-z0-9_]*(?=\s*\()" attribute="Function" context="#pop"/>
      </context>

      <context name="RecordDefName" attribute="Normal Text" lineEndContext="#pop">
        <RegExpr String="[A-Za-z_][A-Za-z0-9_]*" attribute="DataType" context="#pop"/>
      </context>

      <context name="TypeTag" attribute="Normal Text" lineEndContext="#pop">
        <RegExpr String="[fs]\b" attribute="DataType" context="#pop"/>
      </context>

      <context name="String" attribute="String" lineEndContext="#pop">
        <RegExpr String="\\[ntr0\\']" attribute="SpecialChar" context="#stay"/>
        <RegExpr String="\\." attribute="Error" context="#stay"/>
        <DetectChar char="'" attribute="String" context="#pop"/>
      </context>

      <context name="IndexFloat" attribute="Normal Text" lineEndContext="#pop">
        <RegExpr String=";.*$" attribute="Comment" context="#stay"/>
        <IncludeRules context="Numbers"/>
        <IncludeRules context="Builtins"/>
        <IncludeRules context="ArithOp"/>
        <IncludeRules context="GenericVariable"/>
        <DetectChar char="}" attribute="IndexDelim" context="#pop"/>
      </context>

      <context name="IndexString" attribute="Normal Text" lineEndContext="#pop">
        <IncludeRules context="Numbers"/>
        <IncludeRules context="ArithOp"/>
        <IncludeRules context="GenericVariable"/>
        <DetectChar char="&gt;" attribute="IndexDelim" context="#pop"/>
      </context>

    </contexts>

    <itemDatas>
      <itemData name="Normal Text"  defStyleNum="dsNormal"/>
      <itemData name="Comment"      defStyleNum="dsComment"/>
      <itemData name="String"       defStyleNum="dsString"/>
      <!-- Pascal has no backslash-escape concept at all (its only
           in-string escape is a doubled quote), so its String content
           is one uniform color throughout. Folded SpecialChar into the
           same dsString rather than keeping it distinct. -->
      <itemData name="SpecialChar"  defStyleNum="dsString"/>
      <itemData name="Error"        defStyleNum="dsError"/>
      <!-- Pascal's own Float and Int rules both point at the same
           "Number" itemData -> dsDecVal; it never uses dsFloat at all.
           Matched that here rather than keeping floats visually split
           from integers. -->
      <itemData name="Float"        defStyleNum="dsDecVal"/>
      <itemData name="DecVal"       defStyleNum="dsDecVal"/>
      <itemData name="Keyword"      defStyleNum="dsKeyword"/>
      <itemData name="DataType"     defStyleNum="dsDataType"/>
      <!-- Structural: one deliberate departure from stock Pascal's flat
           keyword treatment. F/P and the loop/conditional keywords
           (LF/LW/DO/LOCATE/until, W/IF/E) are the tokens that mark out
           a program's actual shape - function bounds, loop bounds,
           branch bounds - so they get dsOthers instead of plain
           dsKeyword: every shipped Kate color scheme already tunes
           dsOthers to sit one small step above Normal Text without
           introducing a clashing hue (it's the same role Pascal's own
           file uses it for on {$...} directives), so this reads as a
           deliberate, restrained highlight in light or dark schemes
           alike rather than a color that only works in one of them.
           BREAK/CALL/ADD/OR/AND/NOR/XOR/not stay on plain Keyword. -->
      <itemData name="Structural"  defStyleNum="dsOthers"/>
      <!-- Pascal doesn't color symbol operators at all - no +, -, :=,
           <, etc anywhere in its rules. Matched that by leaving these
           as plain text. (Its WORD operators - and/or/xor/not/div/mod
           - are a different story: those are plain dsKeyword in
           Pascal, same as any other reserved word, which is why
           logicalWord/bitwiseWord above point at Keyword directly
           rather than through this entry. Same reasoning applies to
           includeKeyword, Pascal's own "uses" equivalent - it points
           straight at Keyword too, dsImport exists but Pascal never
           actually uses it.) -->
      <itemData name="Operator"     defStyleNum="dsNormal"/>
      <!-- Pascal doesn't color standard-library call names (writeln,
           readln, etc) any differently from user functions - both are
           just plain text, only the function/procedure keyword itself
           is colored. Matched that here. -->
      <itemData name="BuiltIn"      defStyleNum="dsNormal"/>
      <itemData name="Function"     defStyleNum="dsNormal"/>
      <itemData name="Variable"     defStyleNum="dsNormal"/>
      <itemData name="Extension"    defStyleNum="dsNormal"/>
      <itemData name="IndexDelim"   defStyleNum="dsNormal"/>
      <!-- Directive: the real match for Pascal's own {$...} compiler
           directives, which get dsOthers - the one place Pascal does
           break out a distinct non-keyword category. rockskunk's |D
           block is the direct equivalent, so it gets the same style. -->
      <itemData name="Directive"    defStyleNum="dsOthers"/>
    </itemDatas>

  </highlighting>

  <general>
    <comments>
      <comment name="singleLine" start=";"/>
    </comments>
    <keywords casesensitive="1"/>
  </general>

</language>
